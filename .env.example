# Upstash Redis (REST). Either naming works:
#   - UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN (Upstash console)
#   - KV_REST_API_URL / KV_REST_API_TOKEN (Vercel Marketplace integration)
# If neither is set, lib/db.ts falls back to an in-memory store seeded with sample data.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin sign-in (required). Use a long passphrase: it also guards the guest-screen lock.
ADMIN_PASSWORD=
# Optional: signs cookies instead of ADMIN_PASSWORD. Set it if you want to change the
# password later without having to re-approve every screen.
SESSION_SECRET=
